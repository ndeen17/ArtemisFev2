# Local-only env vars for Vite. Copy to .env.local for development.
# Defaults work via the dev proxy in vite.config.ts (/api -> http://localhost:4000).
#
# IMPORTANT for production (Vercel):
#   Leave VITE_API_BASE_URL unset (or set to "/api") so the FE talks to the
#   same origin. vercel.json rewrites /api/* -> the BE. This keeps the
#   refresh-token cookie first-party to *.vercel.app, which is what stops
#   the random sign-outs caused by third-party-cookie blocking on
#   *.onrender.com (onrender.com is on the Public Suffix List, so the
#   browser treats FE and BE as different sites).
VITE_API_BASE_URL=/api

# WebSocket origin for the voice-mode interview gateway. Vercel rewrites do
# NOT proxy WebSockets, so this must point at the BE directly. Auth happens
# via ?token= in the URL (no cookie), so cross-origin is fine here.
#   dev:   leave unset (Vite proxies /ws -> ws://localhost:4000)
#   prod:  wss://<your-backend>.onrender.com/ws
VITE_WS_BASE_URL=

# Google Identity Services client ID (must match GOOGLE_CLIENT_ID in the backend).
VITE_GOOGLE_CLIENT_ID=
